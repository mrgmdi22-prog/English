rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // حساب المعلم الذي يوافق على الأسماء (Google)
    function isTeacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['mr.gmdi22@gmail.com'];
    }
    // الأسماء المستعارة المقترحة: تظهر في اللوحة فوراً دون موافقة المعلم
    function suggested(n) {
      return n in ["نسر العقيق", "صقر الباحة", "ذئب الجبال", "فهد الصحراء", "شبح الليل", "برق الشمال", "إعصار الجنوب", "ملك الكلمات", "سيد المفردات", "قناص النقاط", "صياد النجوم", "محارب الحروف", "فارس اللغة", "عاصفة رملية", "نجم الثانوية", "الرقم الصعب", "بطل التحدي", "الأسطورة", "الظل الصامت", "الذئب الأبيض", "النمر الأسود", "الصقر الذهبي", "الشهاب", "المذنّب", "الكوكب الأزرق", "نيزك", "بركان", "زلزال", "إعصار", "الرعد", "سهم النار", "درع الفولاذ", "القائد", "الجنرال", "الكابتن", "المحترف", "الخبير", "العبقري", "المخطط", "الداهية", "المستكشف", "الرحّالة", "البحّار", "الطيار", "رائد الفضاء", "حارس المجرة", "سيد الوقت", "صانع الأرقام", "الماسة", "الياقوتة السوداء", "الجوكر الذكي", "اللاعب رقم 1", "الهداف", "صانع الألعاب", "حارس المرمى", "الجناح الطائر", "المهاجم", "الفريق الأخضر", "السرعة القصوى", "التوربو", "النيترو", "محرك V8", "الدرفت", "سيد الطريق", "المستوى الأخير", "البوس النهائي", "ضربة قاضية", "كومبو", "الفوز الكبير", "أبو النقاط", "جبل السودة", "غيمة الباحة", "ضباب الجبال", "شلال العقيق", "نخلة الوادي", "ورد الطائف", "سدر الوادي", "عرعر الجبل", "قمة الشفا", "ريح الشمال", "ليل البادية", "سهيل", "الثريا", "الجوزاء", "نجم القطب", "القمر المكتمل", "شمس الظهيرة", "موج البحر", "المرجان", "اللؤلؤ", "الحوت الأزرق", "القرش", "الأخطبوط", "العنقاء", "التنين", "الغريفين", "الأسد الجبلي", "الوشق", "الصقر الحر", "الشاهين", "العقاب", "البومة الحكيمة", "الغراب الذكي", "الثعلب الماكر", "الحصان الأصيل", "الخيل العربية", "الجمل الصبور", "Sky Hunter", "Night Falcon", "Desert Wolf", "Storm Rider", "Ghost Ninja", "Shadow Fox", "Iron Eagle", "Thunder Bolt", "Fire Hawk", "Ice Tiger", "Star Chaser", "Word Master", "Vocab King", "Grammar Boss", "Brain Storm", "Smart Shark", "Speedy Falcon", "Turbo Ace", "Nitro Boost", "Pixel Hero", "Code Breaker", "Level Up", "Final Boss", "Combo King", "Pro Player", "Top Scorer", "MVP Player", "Golden Boot", "Rocket Boy", "Space Ranger", "Galaxy Rider", "Moon Walker", "Comet Blaze", "Meteor Strike", "Solar Flare", "Night Rider", "Silver Arrow", "Red Dragon", "Blue Phoenix", "Green Viper", "Black Jaguar", "White Wolf", "Alpha Leader", "Captain Alpha", "Mr Genius", "The Legend", "The Champion", "Victory Ace", "Quiz Ninja", "Lucky Star", "Big Brain", "Quick Mind", "Sharp Eye", "Iron Will", "Steel Heart", "Brave Lion", "Wild Falcon", "Mountain Eagle", "Baha Falcon", "Aqiq Eagle", "Desert Storm", "Sand Tiger", "Palm Warrior", "Oasis King", "Falcon Pro", "Hawk Eye", "Eagle One", "Wolf Pack", "Lion Heart", "Bear Power", "Shark Bite", "Cobra Strike", "Scorpion Strike", "Fox Spirit", "Owl Mind", "Raven Shadow", "Night Owl", "Early Bird", "Sun Rise", "Star Light", "Snow Storm", "Rain Maker", "Wind Runner", "Wave Rider", "Fast Track", "High Score", "Max Power", "Super Nova", "Mega Mind", "Ultra Brain", "Zero Gravity", "Light Speed"];
    }
    function validStudentData(d) {
      return d.keys().hasOnly(['nick', 'approved', 'score', 'parts', 'region', 'updatedAt'])
        && (!('region' in d) || (d.region is string && d.region.size() <= 30))
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 20
        && d.score is int && d.score >= 0 && d.score <= 10000
        && d.parts is map && d.approved is bool;
    }

    match /players/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
        || isTeacher()
        || resource.data.approved == true;

      // الطالب ينشئ سجله فقط، ولا يستطيع أن يوافق على نفسه
      allow create: if request.auth != null && request.auth.uid == uid
        && validStudentData(request.resource.data)
        && (request.resource.data.approved == false || suggested(request.resource.data.nick));

      // الطالب يحدّث نقاطه؛ وإذا غيّر اسمه يعود إلى انتظار الموافقة
      allow update: if isTeacher() || (
        request.auth != null && request.auth.uid == uid
        && validStudentData(request.resource.data)
        && ((request.resource.data.nick == resource.data.nick && request.resource.data.approved == resource.data.approved)
            || request.resource.data.approved == false
            || (request.resource.data.approved == true && suggested(request.resource.data.nick))));

      allow delete: if isTeacher();
    }

    // الاسم الحقيقي والصف والشعبة: لا يقرؤها إلا الطالب نفسه والمعلم
    match /private/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isTeacher() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'grade', 'section', 'school', 'updatedAt'])
        && (!('school' in request.resource.data) || (request.resource.data.school is string && request.resource.data.school.size() <= 60))
        && request.resource.data.name is string && request.resource.data.name.size() >= 5 && request.resource.data.name.size() <= 60
        && request.resource.data.grade is string && request.resource.data.grade.size() >= 2 && request.resource.data.grade.size() <= 20
        && request.resource.data.section is string && request.resource.data.section.size() >= 1 && request.resource.data.section.size() <= 10
        && (resource == null || !exists(/databases/$(database)/documents/players/$(uid))
            || get(/databases/$(database)/documents/players/$(uid)).data.approved == false));
      allow delete: if isTeacher();
    }
  }
}
