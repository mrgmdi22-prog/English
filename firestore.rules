rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // حساب المعلم الذي يوافق على الأسماء (Google)
    function isTeacher() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['mr.gmdi22@gmail.com'];
    }
    // الأسماء المستعارة المقترحة: تظهر في اللوحة فوراً دون موافقة المعلم.
    // قائمتها محفوظة في config/nicks، وتحدّثها صفحة المعلم تلقائياً.
    function suggested(n) {
      return exists(/databases/$(database)/documents/config/nicks)
        && n in get(/databases/$(database)/documents/config/nicks).data.list;
    }
    function validStudentData(d) {
      return d.keys().hasOnly(['nick', 'approved', 'score', 'parts', 'region', 'updatedAt'])
        && (!('region' in d) || (d.region is string && d.region.size() <= 30))
        && d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 20
        && d.score is int && d.score >= 0 && d.score <= 10000
        && d.parts is map && d.approved is bool;
    }

    match /players/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid)
        || isTeacher()
        || resource.data.approved == true;

      // الطالب ينشئ سجله فقط، ولا يستطيع أن يوافق على نفسه
      allow create: if request.auth != null && request.auth.uid == uid
        && validStudentData(request.resource.data)
        && (request.resource.data.approved == false || suggested(request.resource.data.nick));

      // الطالب يحدّث نقاطه؛ وإذا غيّر اسمه يعود إلى انتظار الموافقة
      allow update: if isTeacher() || (
        request.auth != null && request.auth.uid == uid
        && validStudentData(request.resource.data)
        && ((request.resource.data.nick == resource.data.nick && request.resource.data.approved == resource.data.approved)
            || request.resource.data.approved == false
            || (request.resource.data.approved == true && suggested(request.resource.data.nick))));

      allow delete: if isTeacher();
    }

    // إعدادات اللوحة (مثل قائمة الأسماء المقترحة): يقرؤها الجميع، ولا يكتبها إلا المعلم
    match /config/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // الاسم الحقيقي والصف والشعبة: لا يقرؤها إلا الطالب نفسه والمعلم
    match /private/{uid} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isTeacher() || (
        request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'grade', 'section', 'school', 'updatedAt'])
        && (!('school' in request.resource.data) || (request.resource.data.school is string && request.resource.data.school.size() <= 60))
        && request.resource.data.name is string && request.resource.data.name.size() >= 5 && request.resource.data.name.size() <= 60
        && request.resource.data.grade is string && request.resource.data.grade.size() >= 2 && request.resource.data.grade.size() <= 20
        && request.resource.data.section is string && request.resource.data.section.size() >= 1 && request.resource.data.section.size() <= 10
        && (resource == null || !exists(/databases/$(database)/documents/players/$(uid))
            || get(/databases/$(database)/documents/players/$(uid)).data.approved == false));
      allow delete: if isTeacher();
    }
  }
}
